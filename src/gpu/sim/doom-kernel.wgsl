// doom-kernel.wgsl -- one step of the PSX Doom fire automaton, as a function of one cell.
//
// The rule (Fabien Sanglard, "How Doom Fire Was Done"): a grid of heat; the bottom row is held
// hot; every other cell takes the heat of a cell in the row below it, picked a random few columns
// to one side, and on a coin toss loses a fixed amount. Heat therefore climbs one row a step,
// wanders sideways and cools as it goes, and that is the whole fire.
//
// Both backends include this file and call `doom_next` for every cell: doom-render.wgsl from a
// fragment shader, doom-compute.wgsl from a compute shader. Nothing else differs between them, so
// they cannot drift apart. The CPU side is doom.ts.
//
// The original draws its two random numbers per cell from white noise. Run in parallel on a GPU
// (every cell gathering, instead of the original's in-place scatter), white noise smears heat
// sideways a little every row and never upward, and the picture turns into horizontal dashes.
// So the random numbers here can be made to agree between neighbours: a slow, smooth "gust" field
// leans the sideways pick and scales the cooling, and what is left of the white noise is the
// grain. With `sway` and `patchy` at 0 and `grain` at its full value it is the original again.
//
// Everything that decides WHERE heat goes and WHETHER it cools is integer arithmetic on hashes of
// (cell, step), so the same seed gives the same fire on every device, in both backends, in every
// run. Heat itself is kept on a grid of DOOM_QUANTUM = 1/1024, which a half float holds exactly
// up to 2.0: what is stored in the `rgba16float` state is exactly what was computed, whichever
// way a driver rounds.
//
// Bindings (doom.ts builds the layouts):
//   @group(0) @binding(0) sim: DoomStep      this step's settings; struct generated by doom.ts
//   @group(0) @binding(1) ig: Igniters       this step's taps, drags and embers (ignite.wgsl)
//   @group(1) @binding(0) doom_prev          the state before this step; heat in .r
//
//   doom_gust(cell) -> vec2u      two smooth fields at this cell and step, each 0..65535
//   doom_base(x, size) -> f32     heat the bottom row holds in column x: the standing fuel
//   doom_next(cell) -> vec4f      the new state of `cell` ((0, 0) is the top-left cell)
#include "hash.wgsl"
#include "ignite.wgsl"
#include "doom-uniforms.wgsl"

@group(0) @binding(0) var<uniform> sim: DoomStep;
@group(0) @binding(1) var<uniform> ig: Igniters;
@group(1) @binding(0) var doom_prev: texture_2d<f32>;

const DOOM_QUANTUM: f32 = 1.0 / 1024.0;

// Fixed-point smoothstep: f and the result are in 0..256.
fn doom_ease(f: u32) -> u32 {
  return (f * f * (768u - 2u * f)) >> 16u;
}

// Fixed-point mix of two 16-bit values by w in 0..256.
fn doom_mix(a: vec2u, b: vec2u, w: u32) -> vec2u {
  return (a * (256u - w) + b * w) >> vec2u(8u);
}

// One lattice point of the gust field: two independent 16-bit values.
fn doom_knot(p: vec3u, salt: u32) -> vec2u {
  return pcg_3d(p + vec3u(sim.seed * 7919u + salt)).xy >> vec2u(16u);
}

// Smooth value noise in space and time on a lattice of `cells` cells and `beat` steps: trilinear
// with eased weights, all in integers. Two independent fields, each 0..65535.
fn doom_octave(x: u32, y: u32, t: u32, cells: vec2u, beat: u32, salt: u32) -> vec2u {
  let knot = vec3u(x / cells.x, y / cells.y, t / beat);
  let wx = doom_ease((x % cells.x) * 256u / cells.x);
  let wy = doom_ease((y % cells.y) * 256u / cells.y);
  let wt = doom_ease((t % beat) * 256u / beat);
  let early = doom_mix(
    doom_mix(doom_knot(knot, salt), doom_knot(knot + vec3u(1u, 0u, 0u), salt), wx),
    doom_mix(doom_knot(knot + vec3u(0u, 1u, 0u), salt), doom_knot(knot + vec3u(1u, 1u, 0u), salt), wx),
    wy,
  );
  let late = doom_mix(
    doom_mix(doom_knot(knot + vec3u(0u, 0u, 1u), salt), doom_knot(knot + vec3u(1u, 0u, 1u), salt), wx),
    doom_mix(doom_knot(knot + vec3u(0u, 1u, 1u), salt), doom_knot(knot + vec3u(1u, 1u, 1u), salt), wx),
    wy,
  );
  return doom_mix(early, late, wt);
}

// The gust field at a cell, climbing `gust_climb` cells. Two fields, 0..65535, centred on 32768:
//   .x leans the sideways pick. It is six gusts wide, so neighbours lean together: a lean that
//      differed from column to column would squeeze heat into bright threads here and pull it
//      into flat dashes there, because nothing in this automaton can move heat up or down to
//      make room. It changes quickly with height and time instead, which bends tongues into S's.
//   .y scales the cooling: a gust-sized octave and a quicker one of a third the size, which is
//      what separates one tongue from the next.
fn doom_gust(cell: vec2i) -> vec2u {
  let x = u32(cell.x);
  let y = u32(cell.y) + sim.gust_climb;
  let wide = vec2u(sim.gust_cells.x * 6u, max(sim.gust_cells.y * 2u / 3u, 1u));
  let fine = max(sim.gust_cells / vec2u(3u), vec2u(1u));
  let lean = doom_octave(x, y, sim.tick, wide, sim.gust_beat, 0u).x;
  let slow = doom_octave(x, y, sim.tick, sim.gust_cells, sim.gust_beat, 53u).y;
  let quick = doom_octave(x, y + sim.gust_climb, sim.tick, fine, max(sim.gust_beat / 2u, 1u), 101u).y;
  return vec2u(lean, (slow * 5u + quick * 3u) >> 3u);
}

// Smooth value noise on an integer lattice, 0..1 (floats: it only shapes the base row).
fn doom_lump(p: vec2f) -> f32 {
  let cell = vec2i(floor(p));
  let f = fract(p);
  let w = f * f * (3.0 - 2.0 * f);
  let a = ihash_2to1(cell);
  let b = ihash_2to1(cell + vec2i(1, 0));
  let c = ihash_2to1(cell + vec2i(0, 1));
  let d = ihash_2to1(cell + vec2i(1, 1));
  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}

// The standing fuel. With `uneven` 0 it is the classic: one level across the whole row. Otherwise
// the level dips between lumps that come and go, so the wall breaks into separate fires.
fn doom_base(x: i32, size: vec2i) -> f32 {
  if (sim.uneven <= 0.0) {
    return sim.fuel;
  }
  // Lumps are counted along the grid's SHORTER side, so a wide canvas gets more of them, not
  // wider ones, and a tall one is not given a few enormous ones.
  let along = (f32(x) + 0.5) / f32(min(size.x, size.y)) * sim.lumps + f32(sim.seed & 255u);
  let wide = doom_lump(vec2f(along, sim.drift));
  let narrow = doom_lump(vec2f(along * 2.7 + 17.0, sim.drift * 2.3 + 5.0));
  // Ridges, not hills: a crest where the noise crosses its middle, so the fuel peaks and the
  // flames above it come to tips. The crest is rounded off a little (a smooth |v|): a perfectly
  // sharp one feeds a single column, which rises as a thin bright thread.
  let a = 2.0 * wide - 1.0;
  let b = 2.0 * narrow - 1.0;
  let crest = 0.6 * sqrt(a * a + 0.01) + 0.4 * sqrt(b * b + 0.01) - 0.1;
  let dip = clamp(crest * 2.4, 0.0, 1.0);
  return sim.fuel * (1.0 - sim.uneven * dip);
}

fn doom_next(cell: vec2i) -> vec4f {
  let size = vec2i(textureDimensions(doom_prev));
  // Three independent words of white noise for this cell at this step.
  let rnd = pcg_3d(vec3u(u32(cell.x), u32(cell.y), sim.tick ^ (sim.seed * 2654435769u)));

  var heat: f32;
  if (cell.y >= size.y - 1) {
    heat = doom_base(cell.x, size);
  } else {
    var gust = vec2u(32768u);
    if (sim.sway != 0 || sim.patchy != 0) {
      gust = doom_gust(cell);
    }
    // Which column of the row below to take. The original's part: one of `choices` neighbours,
    // each equally likely.
    let pick = i32(((rnd.x >> 16u) * sim.choices) >> 16u) - sim.reach_left;
    // The wind's part, in 1/4096 of a cell: the steady wind plus the gust field. Its whole cells
    // are taken as they are and the fraction is a probability, so the mean is exact.
    let lean = sim.wind + (((i32(gust.x) - 32768) * sim.sway) >> 15u);
    let carry = (lean >> 12u) + i32((rnd.z >> 20u) < u32(lean & 4095));
    let column = clamp(cell.x + pick + carry, 0, size.x - 1);
    // Which row. The original always takes the row directly below. Taking the one under it
    // instead, with probability `lift`, spreads heat along its path as the sideways pick spreads
    // it across, so a spark stays a spark instead of flattening into a dash, and the fire climbs
    // 1 + lift rows a step. The bottom row is as far down as there is.
    let rows = 1 + i32(((rnd.z >> 8u) & 4095u) < sim.lift);
    let row = min(cell.y + rows, size.y - 1);
    let below = textureLoad(doom_prev, vec2i(column, row), 0).r;
    // Cooling, in 1/256 of a heat quantum. The original tosses a fair coin: lose a fixed amount
    // or nothing, because its 37 heat levels could not hold half a level. With `grain` 1 that is
    // what happens here. With less, the two outcomes move together toward the mean, and the gust
    // field makes the mean itself larger here and smaller there, which opens gaps between tongues.
    let mean = (sim.cooling * u32(4096 + (((i32(gust.y) - 32768) * sim.patchy) >> 15u))) >> 12u;
    let toss = select(-sim.grain, sim.grain, (rnd.y >> 31u) == 1u);
    let loss = u32(max(i32(mean) + toss, 0)) * u32(row - cell.y);
    // Whole quanta are taken as they are; the fraction is a probability, so the mean is exact.
    let quanta = (loss >> 8u) + u32(((rnd.y >> 8u) & 255u) < (loss & 255u));
    heat = max(below - f32(quanta) * DOOM_QUANTUM, 0.0);
  }

  // Heat from outside: pointers and stray embers, in canvas uv (the grid covers the canvas). An
  // igniter is a source like the base row, hot in the middle and cooler toward its rim, so it
  // RAISES the cell to its own heat instead of adding to it: a pointer held still makes a flame
  // that tapers, not a block that has piled up to the clamp.
  if (ig.count > 0u) {
    let uv = (vec2f(cell) + 0.5) / vec2f(size);
    var lit = 0.0;
    for (var i = 0u; i < ig.count; i++) {
      lit = max(lit, ignite_one(uv, ig.aspect, ig.segments[i], ig.shapes[i]));
    }
    heat = max(heat, lit);
  }

  heat = round(clamp(heat, 0.0, sim.heat_max) / DOOM_QUANTUM) * DOOM_QUANTUM;
  return vec4f(heat, 0.0, 0.0, 1.0);
}
