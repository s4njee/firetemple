{
  "name": "firetemple",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown \"src/**\" \"tests/**\" \"scripts/**\" \"*.{ts,js,json,html}\"",
    "format:check": "prettier --check --ignore-unknown \"src/**\" \"tests/**\" \"scripts/**\" \"*.{ts,js,json,html}\"",
    "test": "vitest run",
    "study": "node scripts/study.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "webgpu": "^0.6.2"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "shiki": "^4.5.0",
    "tweakpane": "^4.0.5",
    "wgpu-matrix": "^3.4.2"
  }
}
